def insertion_sort(lista):
    """
    Ordena una lista usando Insertion Sort
    """
    for i in range(1, len(lista)):              # Itero desde el segundo elemento hasta el final
        elemento_actual = lista[i]              # Guardo el elemento actual a insertar
        j = i - 1                               # Índice del elemento anterior 
        
        while j >= 0 and lista[j] > elemento_actual:   # Muevo los elementos mayores hacia la derecha 
            lista[j + 1] = lista[j]                    # Desplazo el elemento hacia la derecha 
            j -= 1                                     # Paso al siguiente elemento a la izquierda 
        
        lista[j + 1] = elemento_actual                 # Inserto el elemento en su posición correcta 
    
    return lista                                       # Retorno la lista ordenada 

def busqueda_binaria(lista_ordenada, x):               # defino la funcion busqueda_binaria 
    """
    Realiza búsqueda binaria en lista ordenada (MUCHO más eficiente)
    """
    izquierda, derecha = 0, len(lista_ordenada) - 1    # Defino los índices inicial y final de la lista  
    
    while izquierda <= derecha:                        # Mientras el índice izquierdo no supere al derecho 
        medio = (izquierda + derecha) // 2             # Calculo el índice del elemento medio 
        
        if lista_ordenada[medio] == x:                 # si el elemento medio es igual al valor buscado: 
            return medio  # Elemento encontrado
        elif lista_ordenada[medio] < x:                # Si el elemento medio es menor que el valor buscado: 
            izquierda = medio + 1  # Buscar en la mitad derecha
        else:                                          # Si el elemento medio es mayor que el valor buscado:
            derecha = medio - 1   # Buscar en la mitad izquierda
    
    return -1  # Elemento no encontrado

# Lista original
