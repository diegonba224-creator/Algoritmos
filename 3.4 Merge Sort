def merge_sort_simple(lista):                  # defino la funcion merge_sort_simple 
    """
    Versión simplificada de Merge Sort
    """
    if len(lista) <= 1:                        # Caso base de la recursión 
        return lista                           # Retorno la lista tal cual si tiene 1 o 0 elementos
    
    medio = len(lista) // 2                        # Encuentro el punto medio de la lista 
    izquierda = merge_sort_simple(lista[:medio])   # Ordeno la mitad izquierda recursivamente 
    derecha = merge_sort_simple(lista[medio:])     # Ordeno la mitad derecha recursivamente 
    
    # Mezclar
    resultado = []                                  # Lista para el resultado ordenado 
    i = j = 0                                        # Índices para izquierda y derecha 
    while i < len(izquierda) and j < len(derecha):  # Mientras haya elementos en ambas mitades 
        if izquierda[i] < derecha[j]:                # Comparo elementos 
            resultado.append(izquierda[i])          # Agrego el menor al resultado  
            i += 1                                   # Incremento índice izquierda 
        else:                                       # Si el elemento de la derecha es menor o igual 
            resultado.append(derecha[j])             # Agrego el menor al resultado 
            j += 1                                  # Incremento índice derecha 
    
    return resultado + izquierda[i:] + derecha[j:]   # Retorno la lista ordenada completa 

def buscar_lineal(lista, numero):                   # defino la funcion buscar_lineal 
    """
    Busca un número en la lista (búsqueda lineal simple)
    """
    print(f"\n🔍 Buscando {numero}...")
    
    for i, valor in enumerate(lista):               # Recorro la lista con índice y valor 
        if valor == numero:                          # Si encuentro el número:
            return i                                  # Retorno la posición 
    
    return -1                                         # No encontrado 

