def quick_sort(lista):
    """
    Implementación sencilla de Quick Sort
    """
    if len(lista) <= 1:                                         # si la lista tiene 1 o 0 elementos
        return lista                                            # retorno la lista tal cual (ya está ordenada)
    
    pivote = lista[0]                                              # elijo el primer elemento como pivote 
    menores = [x for x in lista[1:] if x <= pivote]                # elementos menores o iguales al pivote 
    mayores = [x for x in lista[1:] if x > pivote]                 # elementos mayores al pivote 
    
    return quick_sort(menores) + [pivote] + quick_sort(mayores)    # retorno la lista ordenada concatenando menores, pivote y mayores 

# Programa principal
if __name__ == "__main__":
    # Lista desordenada
    numeros = [64, 34, 25, 12, 22, 11, 90, 5]
    
    print("📋 Lista original:", numeros)
    
    # Ordenar la lista
    lista_ordenada = quick_sort(numeros)                             # Aplico Quick Sort a la lista de números 
    
    print("🔢 Lista ordenada:", lista_ordenada)                     
    print("=" * 50)
    
    # Solicitar número a consultar
    try:
        numero_consultar = int(input("🔍 Ingrese el número a consultar: "))  # Solicito el número y lo convierto a entero 
        
        # Buscar el número (forma simple)
        if numero_consultar in lista_ordenada:                              # Verifico si el número está en la lista ordenada 
            posicion = lista_ordenada.index(numero_consultar)               # Obtengo la posición del número 
            print("=" * 50)
            print(f"🎯 ¡NÚMERO ENCONTRADO!")
            print(f"   • Número: {numero_consultar}")
            print(f"   • Posición en lista ordenada: {posicion}")
            print(f"   • Lista completa: {lista_ordenada}")
        else:                                                                 # Si el número no está en la lista ordenada:
            print("=" * 50)
            print(f"❌ El número {numero_consultar} NO existe en la lista")  # Indico que no se encontró el número 
            
    except ValueError:                                                         # Manejo de error si la conversión a entero falla 
        print("❌ Error: Debe ingresar un número válido")
